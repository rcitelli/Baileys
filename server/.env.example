# ---------------------------------------------------------------------------
# Baileys Server — exemplo de configuração. Copie para .env e ajuste.
# ---------------------------------------------------------------------------

# Porta e bind. Atrás do Cloudflare Tunnel, mantenha em localhost.
PORT=3000
HOST=0.0.0.0

# Onde as sessões (credenciais + metadados) são gravadas. No Docker é um volume.
DATA_DIR=./data

# Logs
LOG_LEVEL=info
# true = logs coloridos legíveis (dev). Em produção deixe false (JSON).
LOG_PRETTY=false

# ---------------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------------

# APENAS para desenvolvimento local atrás de firewall. NUNCA use true em produção.
AUTH_DISABLED=false

# Chaves de API para chamadas server-to-server das suas outras aplicações.
# Lista separada por vírgula. Envie em cada request como:
#   Authorization: Bearer <chave>   (ou)   x-api-key: <chave>
# Gere chaves fortes, ex.: openssl rand -hex 32
API_KEYS=troque-esta-chave-por-uma-forte

# Cloudflare Access — protege o painel no navegador (verificação do JWT na origem).
# Domínio da sua equipe (Zero Trust) e o Application Audience (AUD) da aplicação Access.
# CF_ACCESS_TEAM_DOMAIN=https://suaequipe.cloudflareaccess.com
# CF_ACCESS_AUD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hostname público do painel (o mesmo roteado pelo Cloudflare Tunnel). Quando definido,
# requisições que chegam por esse Host DEVEM ser um usuário Cloudflare Access — uma API Key
# sozinha é recusada nesse hostname (assim uma chave vazada não abre nada pela internet).
# As chamadas máquina-a-máquina usam 127.0.0.1 / rede Docker, onde a API Key é aceita.
# PANEL_HOSTNAME=whatsapp.suaempresa.com

# Quantos proxies confiar no X-Forwarded-For. 'loopback' cobre o cloudflared no mesmo host.
TRUST_PROXY=loopback

# Token do Cloudflare Tunnel (perfil "tunnel" do docker-compose). Pegue no Zero Trust ao
# criar o tunnel e rotear o hostname do painel para http://baileys-server:3000.
# TUNNEL_TOKEN=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_SENSITIVE_MAX=30

# ---------------------------------------------------------------------------
# Sessões
# ---------------------------------------------------------------------------

# Reconectar automaticamente as sessões existentes ao iniciar o servidor.
SESSION_AUTOSTART=true
# Marcar o número como sempre online (não recomendado — atrasa recibos de leitura).
SESSION_MARK_ONLINE=false

# ---------------------------------------------------------------------------
# Webhooks (entrega de eventos recebidos às suas aplicações)
# ---------------------------------------------------------------------------

WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BASE_DELAY_MS=1000
WEBHOOK_TIMEOUT_MS=10000
# Segredo opcional enviado no header X-Webhook-Secret para o destino validar a origem.
# WEBHOOK_SECRET=troque-este-segredo
